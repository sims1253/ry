# Everything is bundled into dist/extension.js by esbuild.
.vscode/**
.vscode-test/**
src/**
out/**
node_modules/**
test/**

# Build tooling and configs are not needed at runtime.
esbuild.js
.oxlintrc.json
tsconfig*.json
justfile
.gitignore
bun.lock

# TypeScript sources and source maps are not shipped.
**/*.map
**/*.ts

# The readme references the webp images by absolute URL (vsce rewrites
# relative paths against the repository root), so the packaged copies
# serve nothing. icon.png stays: it is the marketplace listing icon.
images/*.webp
