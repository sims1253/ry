/target
**/*.rs.bk

# Logo concepts are kept local, not tracked
/assets/logo-concept-*

# Local tool caches
/.claude/
.pytest_cache/

# npm lockfile: the extension is managed with bun (bun.lock is tracked)
/editors/code/package-lock.json

# Ecosystem regression harness caches and message-bearing reports
/ecosystem/.cache/
/ecosystem/reports/*.full.txt

# rmarkdown render byproduct (README.md is the tracked output)
/README.html

# Local scratch from agent sessions (not project docs)
/comms.md
/plan-forward-report.html
/time

# Python bytecode from the ecosystem harness
__pycache__/
